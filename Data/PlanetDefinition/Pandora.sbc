		<SurfaceGravity>1.1</SurfaceGravity>
		<DefaultSurfaceMaterial Material="AlienRockGrass" MaxDepth="1"/>
		<DefaultSubSurfaceMaterial Material="AlienRockyMountain"/>

		<AllowMeteors>false</AllowMeteors>
		<SolarRadiationProtectionFactor>1.8</SolarRadiationProtectionFactor>
		<HasAtmosphere>true</HasAtmosphere>

		<AtmosphereSettings>
			<RayleighScattering>
				<X>57</X>
				<Y>17.9645233</Y>
				<Z>100</Z>
			</RayleighScattering>
			<MieScattering>50</MieScattering>
			<MieColorScattering>
				<X>26</X>
				<Y>51</Y>
				<Z>26</Z>
			</MieColorScattering>
			<RayleighHeight>21</RayleighHeight>
			<RayleighHeightSpace>11.2</RayleighHeightSpace>
			<RayleighTransitionModifier>0.4</RayleighTransitionModifier>
			<MieHeight>200</MieHeight>
			<MieG>0.999832332</MieG>
			<Intensity>6</Intensity>
			<FogIntensity>1</FogIntensity>
			<SeaLevelModifier>1.0</SeaLevelModifier>
			<AtmosphereTopModifier>1.100</AtmosphereTopModifier>
